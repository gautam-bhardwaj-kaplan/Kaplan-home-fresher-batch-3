// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  name                   String
  passwordHash           String
  role                   UserRole       @default(LEARNER)
  authProvider           AuthProvider   @default(LOCAL)
  providerId             String?
  profilePicture         String?
  currentStreak          Int           @default(0)
  longestStreak         Int           @default(0)
  lastAttemptDate       DateTime?
  totalQuestionsAttempted Int          @default(0)
  totalCorrectAnswers    Int           @default(0)
  userBadges            UserBadge[] 
  totalPoints           Int           @default(0)
  emailNotifications    Boolean       @default(true)
  notificationTime      String        @default("09:00")
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  questions            Question[]   
  submissions          Submission[]   
  notifications        Notification[] 
}

model Question {
  id              String           @id @default(uuid())
  scheduledDate   DateTime         @unique
  category        QuestionCategory
  difficulty      Difficulty       @default(MEDIUM)
  questionText    String
  questionType    QuestionType     @default(MCQ)
  options         String[]
  correctAnswer   String
  acceptedAnswers String[]
  caseSensitive   Boolean          @default(false)
  explanation     String?
  points          Int              @default(10)
  totalAttempts   Int              @default(0)
  correctAttempts Int              @default(0)
  createdBy       User?            @relation(fields: [createdById], references: [id])
  createdById     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submissions     Submission[]    
  analytics       Analytics[]   
  @@index([category, scheduledDate])
  @@index([isActive, scheduledDate])
}

model Badge {
  id          String      @id @default(uuid())
  badgeId     String      @unique
  name        String
  description String?
  iconUrl     String?
  category    BadgeCategory
  criteriaType CriteriaType
  threshold   Int
  points      Int         @default(0)
  rarity      BadgeRarity @default(COMMON)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[] 

  @@index([category])
}

model UserBadge {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  badgeId   String
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Analytics {
  id               String     @id @default(uuid())
  date             DateTime   @unique
  totalUsers       Int       @default(0)
  activeUsers      Int       @default(0)
  totalAttempts    Int       @default(0)
  correctAttempts  Int       @default(0)
  averageAccuracy  Float     @default(0)
  question         Question?  @relation(fields: [questionId], references: [id])
  questionId       String?
  categoryBreakdown Json     
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([date])
}

model Notification {
  id           String            @id @default(uuid())
  user         User              @relation(fields: [userId], references: [id])
  userId       String
  type         NotificationType
  status       NotificationStatus @default(PENDING)
  scheduledFor DateTime
  sentAt       DateTime?
  subject      String?
  body         String?
  metadata     Json?             
  attempts     Int               @default(0)
  lastError    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}

model Submission {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  question        Question  @relation(fields: [questionId], references: [id])
  questionId      String
  submittedAnswer String
  isCorrect       Boolean
  pointsEarned    Int      @default(0)
  submittedAt     DateTime @default(now())
  attemptDate     DateTime

  @@unique([userId, attemptDate])
  @@index([questionId])
  @@index([userId, submittedAt])
  @@index([attemptDate])
}

enum UserRole {
  LEARNER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum QuestionCategory {
  MATH
  ENGLISH
  CODING
  SCIENCE
  GENERAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
}

enum BadgeCategory {
  STREAK
  ACCURACY
  MILESTONE
}

enum CriteriaType {
  STREAK
  CORRECT_ANSWERS
  TOTAL_ATTEMPTS
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum NotificationType {
  DAILY_REMINDER
  STREAK_ALERT
  BADGE_EARNED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}